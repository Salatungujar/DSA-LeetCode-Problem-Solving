class Solution:
    def longestPalindrome(self, s: str) -> str:
        res = ""
        resLen = 0

        # Treat every index as the center of a potential palindrome
        for i in range(len(s)):
            # Check odd-length palindromes (single character center)
            l, r = i, i
            while l >= 0 and r < len(s) and s[l] == s[r]:
                # Update result if the current palindrome is the longest seen so far
                if (r - l + 1) > resLen:
                    res = s[l : r + 1]
                    resLen = r - l + 1
                l -= 1
                r += 1
        
            # Check even-length palindromes (two-character center)
            l, r = i, i + 1
            while l >= 0 and r < len(s) and s[l] == s[r]:
                if (r - l + 1) > resLen:
                    res = s[l : r + 1]
                    resLen = r - l + 1
                l -= 1
                r += 1

        return res
