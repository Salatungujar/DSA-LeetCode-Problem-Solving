
class Solution:
    def pacificAtlantic(self, heights: list[list[int]]) -> list[list[int]]:
        ROWS, COLS = len(heights), len(heights[0])
        pac, atl = set(), set()

        def dfs(r, c, visit, prevHeight):
            # Check bounds, if already visited, or if the water cannot flow "uphill" in reverse
            if ((r, c) in visit or 
                r < 0 or c < 0 or 
                r == ROWS or c == COLS or 
                heights[r][c] < prevHeight):
                return
                
            # Mark the current cell as reachable
            visit.add((r, c))
            
            # Explore all 4 adjacent directions
            dfs(r + 1, c, visit, heights[r][c])
            dfs(r - 1, c, visit, heights[r][c])
            dfs(r, c + 1, visit, heights[r][c])
            dfs(r, c - 1, visit, heights[r][c])

        # 1. Run DFS for the top and bottom rows
        for c in range(COLS):
            dfs(0, c, pac, heights[0][c])             # Top row (Pacific)
            dfs(ROWS - 1, c, atl, heights[ROWS - 1][c]) # Bottom row (Atlantic)

        # 2. Run DFS for the left and right columns
        for r in range(ROWS):
            dfs(r, 0, pac, heights[r][0])             # Left column (Pacific)
            dfs(r, COLS - 1, atl, heights[r][COLS - 1]) # Right column (Atlantic)

        # 3. Find the intersection where cells can reach both oceans
        res = []
        for r in range(ROWS):
            for c in range(COLS):
                if (r, c) in pac and (r, c) in atl:
                    res.append([r, c])
                    
        return res
