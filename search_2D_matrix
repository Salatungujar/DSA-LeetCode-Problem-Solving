class Solution:
    def searchMatrix(self, matrix: list[list[int]], target: int) -> bool:
        if not matrix or not matrix[0]:
            return False

        m, n = len(matrix), len(matrix[0])
        left, right = 0, n * m - 1  #Boundaries of the virtual 1D array

        while left <= right:
            mid  = (left + right) // 2

            #converting 1D into 2D
            row = mid//n
            col = mid%n
            val = matrix[row][col]

            if val == target:
                return True
            elif val < target:
                left = mid + 1  # search in right part
            else:
                right = mid - 1  # search in left part

        return False
