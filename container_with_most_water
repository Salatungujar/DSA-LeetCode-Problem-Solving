class Solution:
    def maxArea(self, height: list[int]) -> int:
        left = 0
        right = len(height) - 1
        max_area = 0
        while left < right:

            #calculate width
            width = right - left

            #calculate curr_height
            curr_height = min(height[left], height[right])

            #calculate max_area
            max_area = max(max_area, width * curr_height)

            if height[left] < height[right]:
                left += 1
            else :
                right -= 1
        
        return max_area
        
