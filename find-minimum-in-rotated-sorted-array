class Solution:
    def findMin(self, nums: list[int]) -> int:
        low = 0
        high = len(nums) - 1
        mini = float("inf")

        while low <= high:
            mid = (low + high)//2

            # If the right half is sorted, update mini and search the left half
            if nums[mid] <= nums[high]:
                mini = min(mini, nums[mid])
                high = mid - 1
            # If the left half is sorted, update mini and search the right half    
            else:
                mini = min(mini, nums[low])
                low = mid + 1

        return mini
