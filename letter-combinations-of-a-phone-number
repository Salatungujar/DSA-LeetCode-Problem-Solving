class Solution:
    def letterCombinations(self, digits: str) -> list[str]:
        res = []

        # Map each phone digit to its corresponding letters
        digitToChar = {"2" : "abc",
                        "3" : "def",
                        "4" : "ghi",
                        "5" : "jkl",
                        "6" : "mno",
                        "7" : "pqrs",
                        "8" : "tuv",
                        "9" : "wxyz"}

        def backtrack(i, curStr):
            # Base case: valid combination found when lengths match
            if len(curStr) == len(digits):
                res.append(curStr)
                return
            

            # Explore all possible letters for the current digit
            for c in digitToChar[digits[i]]:
                backtrack(i + 1, curStr + c)
                
        # Kick off backtracking only if the input string is not empty    
        if digits:
            backtrack(0, "")
        return res
