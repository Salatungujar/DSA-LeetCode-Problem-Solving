class Solution:
    def findItinerary(self, tickets: List[List[str]]) -> List[str]:
        adj = defaultdict(list)
        # Sort in reverse so we can pop the smallest destination in O(1) time
        for src, dst in sorted(tickets, reverse=True):
            adj[src].append(dst)
            
        res = []
        def dfs(src):
            # Visit all outgoing flights greedily
            while adj[src]:
                next_dst = adj[src].pop()
                dfs(next_dst)
            # Add airport to result after all its edges are explored (post-order)
            res.append(src)
            
        dfs("JFK")
        # Reverse the post-order path to get the correct itinerary
        return res[::-1]
