class Solution:
    def findKthLargest(self, nums: list[int], k: int) -> int:
        # Convert k-th largest to the corresponding 0-indexed position in a sorted array
        k = len(nums) - k

        def quickSelect(l, r):
            pivot, p = nums[r], l

            # Partition: elements smaller than or equal to pivot are moved to the left
            for i in range(l, r):
                if nums[i] <= pivot:
                    nums[i], nums[p] = nums[p], nums[i]
                    p += 1

            # Place the pivot in its correct sorted position        
            nums[p], nums[r] = nums[r], nums[p]

            # Recursively search the left or right sub-array
            if p < k:
                return quickSelect(p + 1, r)
            elif p > k:
                return quickSelect(l, p - 1)
            else:
                return nums[p]

        return quickSelect(0, len(nums) - 1)
