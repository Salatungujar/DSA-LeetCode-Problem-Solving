class Solution:
    def search(self, nums: list[int], target: int) -> int:
        left, right = 0, len(nums) - 1

        while left <= right:

            #mid  = (left + right) // 2 #this logic will cause overflow
            mid = left + (right - left) // 2 # this logic is use to prevent from overflow

            if nums[mid] == target:
                return mid
            elif nums[mid] < target:
                left = mid + 1  # search in right part
            else:
                right = mid - 1  #search in left part

        return -1
