class Solution:
    def findKthLargest(self, nums: list[int], k: int) -> int:
        # Initialize a min-heap with the first k elements
        heap = nums[:k]
        heapq.heapify(heap)
        
        # Push remaining elements and pop the smallest to keep heap size at k
        for num in nums[k:]:
            if num > heap[0]:
                heapq.heappushpop(heap, num)
                
        # The root is the k-th largest element
        return heap[0]
