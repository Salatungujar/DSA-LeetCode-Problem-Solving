class Solution:
  # TC: O(V + E * α(V)) | SC: O(V)
  def countComponents(self, n: int, edges: List[List[int]]) -> int:
    # Each node starts as its own parent with component size (rank) 1
    par = [i for i in range(n)]
    rank = [1] * n

    def find(n1):
      res = n1
      # Traverse up until we reach the root parent
      while res != par[res]:
        # Path compression: point node to its grandparent to flatten the tree
        par[res] = par[par[res]]
        res = par[res]
      return res

    def union(n1, n2):
      p1, p2 = find(n1), find(n2)

      # Already connected; no merge needed
      if p1 == p2:
        return 0

      # Union by rank: attach smaller tree under the larger tree's root
      if rank[p2] > rank[p1]:
        par[p1] = p2
        rank[p2] += rank[p1]
      else:
        par[p2] = p1
        rank[p1] += rank[p2]

      # Return 1 to indicate a successful merge
      return 1

    # Start with n separate components and subtract 1 for each merge
    res = n
    for n1, n2 in edges:
      res -= union(n1, n2)

    return res
