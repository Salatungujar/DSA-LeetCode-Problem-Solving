class Solution:
    def numIslands(self, grid: List[List[str]]) -> int:
        # Return 0 if the grid is empty
        if not grid:
            return 0
        
        # Get the dimensions of the grid
        row, col = len(grid), len(grid[0])

        # Set to keep track of already visited land cells
        visit = set()

        # Counter for the total number of islands
        islands = 0

        # Helper function to perform Breadth-First Search
        def bfs(r, c):
            q = collections.deque()
            visit.add((r, c))   # Mark the starting cell as visited
            q.append((r, c))    # Add it to the queue

            # Continue searching until all connected land cells are visited
            while q:
                rows, cols = q.popleft()
                # Define the 4 possible directions: Down, Up, Right, Left
                directions = [[1, 0], [-1, 0], [0, 1], [0, -1]]
                for dr, dc in directions:
                    r, c = rows + dr, cols + dc

                    # Check if the new coordinates are within bounds, 
                    # represent land ("1"), and have not been visited yet
                    if (r in range(row) and
                        c in range(col) and
                        grid[r][c] == "1" and
                        (r, c) not in visit ):

                        q.append((r, c))
                        visit.add((r, c))

        
        # Iterate through every cell in the grid
        for r in range(row):
            for c in range(col):
                # If we find an unvisited land cell, it's the start of a new island
                if (grid[r][c] == "1" and (r, c) not in visit):
                    bfs(r, c)
                    islands += 1
        return islands
