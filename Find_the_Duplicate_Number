class Solution:
    def findDuplicate(self, nums: list[int]) -> int:
    
        # Phase 1: Find the intersection point of the two pointers
        slow = nums[0]
        fast = nums[0]
        
        # Move slow by 1 step and fast by 2 steps until they meet
        while True:
            slow = nums[slow]
            fast = nums[nums[fast]]
            if slow == fast:
                break
                
        # Phase 2: Find the entrance to the cycle (the duplicate)
        slow = nums[0]  # Reset slow pointer to the beginning
        
        # Move both pointers 1 step at a time until they meet again
        while slow != fast:
            slow = nums[slow]
            fast = nums[fast]
            
        return slow  # Or return fast, since they are pointing to the same duplicate number
