class Solution:
    def orangesRotting(self, grid: list[list[int]]) -> int:
        q = deque()
        time, fresh = 0, 0
        ROWS, COLS = len(grid), len(grid[0])
        
        # 1. Scan the grid to count fresh oranges and enqueue initial rotten ones
        for r in range(ROWS):
            for c in range(COLS):
                if grid[r][c] == 1:
                    fresh += 1
                elif grid[r][c] == 2:
                    q.append([r, c])
        
        # 4-directional movements: right, left, down, up
        directions = [[0, 1], [0, -1], [1, 0], [-1, 0]]
        
        # 2. Perform Breadth-First Search (BFS) layer by layer
        while q and fresh > 0:
            # Process all oranges currently rotten at this minute
            for i in range(len(q)):
                r, c = q.popleft()
                
                # Check all 4 adjacent neighbors
                for dr, dc in directions:
                    row, col = dr + r, dc + c
                    
                    # Skip if out of bounds or if the orange isn't fresh
                    if (row < 0 or row >= ROWS or
                        col < 0 or col >= COLS or
                        grid[row][col] != 1):
                        continue
                    
                    # Rot the fresh orange and add it to the queue for the next minute
                    grid[row][col] = 2
                    q.append((row, col))
                    fresh -= 1 # One less fresh orange remaining
            
            time += 1 # Increment time after a full layer/minute finishes
            
        # 3. Return time if all oranges rotted, otherwise return -1
        return time if fresh == 0 else -1
