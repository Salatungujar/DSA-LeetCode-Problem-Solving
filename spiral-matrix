class Solution:
    def spiralOrder(self, matrix: list[list[int]]) -> list[int]:
        # Handle edge case for empty matrix
        if not matrix or not matrix[0]:
            return []

        result = []
        # Initialize boundaries for the matrix (0-indexed)
        top, left = 0, 0
        bottom, right = len(matrix) - 1, len(matrix[0]) - 1

        while top <= bottom and left <= right:
            # 1. Traverse from left to right across the top row
            for i in range(left, right + 1):
                result.append(matrix[top][i])
            top += 1   # Move top boundary down

            # 2. Traverse from top to bottom down the right column
            for i in range(top, bottom + 1):
                result.append(matrix[i][right])
            right -= 1    # Move right boundary left

            # 3. Traverse from right to left across the bottom row (if rows remain)
            if top <= bottom:
                for i in range(right, left - 1, -1):
                    result.append(matrix[bottom][i])
                bottom -= 1  # Move bottom boundary up
            
            # 4. Traverse from bottom to top up the left column (if columns remain)
            if left <= right:
                for i in range(bottom, top - 1, -1):
                    result.append(matrix[i][left])
                left += 1   # Move left boundary right
                
        return result
