# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution:
    def isBalanced(self, root: TreeNode | None) -> bool:
        
        def dfs(root):

            # Base case: an empty node is balanced and has a height of 0
            if not root:
                return [True, 0]

            # Recursively check left and right subtrees for balance and height
            left, right = dfs(root.left), dfs(root.right)

            # Check if current node is balanced (subtrees are balanced and height diff <= 1)
            balanced = (left[0] and right[0] and
                        abs(left[-1] - right[1]) <= 1)

            # Return balance status and the current node's height (1 plus max subtree height)
            return [balanced, 1 + max(left[1], right[1])]
        
        # Start DFS traversal from root and return its balance status boolean
        return dfs(root)[0]
        
