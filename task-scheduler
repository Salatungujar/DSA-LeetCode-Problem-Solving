class Solution:
    def leastInterval(self, tasks: list[str], n: int) -> int:
        count = Counter(tasks)

        # Max-heap for highest frequency tasks (negative for min-heap)
        maxHeap = [-cnt for cnt in count.values()]
        heapq.heapify(maxHeap)

        time = 0
        q = deque()    # stores pairs of [-remaining_count, available_time]
        while maxHeap or q:
            time += 1   # Process 1 CPU cycle
            if maxHeap:
                cnt = 1 + heapq.heappop(maxHeap)    # Execute task (decrement count)
                if cnt:
                    q.append([cnt, time + n])        # Send to cooldown queue

            # Check if any cooled-down task can return to the heap        
            if q and q[0][1] == time:
                heapq.heappush(maxHeap, q.popleft()[0])
        return time
