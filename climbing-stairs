class Solution:
    def climbStairs(self, n: int) -> int:
        # Base cases: ways to reach the top from the last two steps
        one, two = 1, 1

        # Bottom-up DP: ways to reach current step = sum of the next two steps (Fibonacci)
        for i in range(n - 1):
            temp = one
            one = one + two
            two = temp

        return one
