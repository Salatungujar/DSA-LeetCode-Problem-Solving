# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution:
    def maxPathSum(self, root: TreeNode | None) -> int:
        # Initialize result with the root's value to handle trees with negative numbers
        res = [root.val]
        def dfs(root):
            # Base case: if the node is null, its contribution to the path sum is 0
            if not root:
                return 0

            # Recursively get the max path sum from left and right subtrees
            leftMax = dfs(root.left)
            rightMax = dfs(root.right)

            # Ignore paths with negative sums by taking max with 0
            leftMax = max(leftMax, 0)
            rightMax = max(rightMax, 0)

            # Compute the max path sum passing through the current node as the "root" of the path
            res[0] = max(res[0], root.val + leftMax + rightMax)

            # Return the max sum of a path extending from this node down to one of its children
            return root.val + max(leftMax, rightMax)

        dfs(root)
        return res[0]
